# Copy to .env and fill in. Do not commit .env.

# Chat model and embeddings.
OPENAI_API_KEY=sk-...
# Optional. Code default is gpt-5-nano.
AGENT_MODEL=gpt-5-nano
# Must be text-embedding-3-small while the S3 index is 1,024 dimensions.
EMBEDDING_MODEL=text-embedding-3-small

# Required by the SEC on every request: your name and a real contact email.
SEC_USER_AGENT="Your Name you@email.com"

# S3 Vectors (us-east-1). The bucket is a vector bucket, not a normal S3 bucket.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
VECTOR_BUCKET=your-vector-bucket
VECTOR_INDEX=filing-chunks

# Optional API guardrails (defaults shown).
# ASK_LIMIT_PER_HOUR=10
# DAILY_TOKEN_BUDGET=2000000
